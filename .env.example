# ─────────────────────────────────────────────────────────────────────────────
# Pulse demo: environment variables
# Copy this file to .env and fill in the values.  `npm run ld:setup` fills in
# the LaunchDarkly values for you once LD_API_TOKEN is set.
# ─────────────────────────────────────────────────────────────────────────────

# 1) LaunchDarkly REST API access token (only used by scripts/ld-setup.js).
#    Create one at: LaunchDarkly → Organization settings → Authorization →
#    Access tokens → "Create token" (role: Admin, since the setup script
#    creates a new project).
#    Never deploy this value. It stays on your machine.
LD_API_TOKEN=

# LaunchDarkly project and environment the demo uses. The setup script creates
# the project if it does not exist.
LD_PROJECT_KEY=pulse-demo
LD_ENV_KEY=production

# 2) Written by `npm run ld:setup`. Or copy them from LaunchDarkly →
#    Project settings → Environments → production.
#    Client-side ID: safe to expose in the browser (that's what it's for).
VITE_LD_CLIENT_SIDE_ID=
#    Server-side SDK key: SECRET. Used only by the /api functions and scripts.
LD_SDK_KEY=
#    Flag trigger URL that turns OFF the release flag (Part 1 "Remediate").
#    SECRET: anyone with this URL can turn the flag off.
LD_KILL_SWITCH_TRIGGER_URL=

# 3) Anthropic API key for the AI features (chatbot + incident summaries).
#    Get one at https://console.anthropic.com → API keys. Set a monthly spend
#    limit there. Leave blank to run with canned (mock) AI responses.
ANTHROPIC_API_KEY=
