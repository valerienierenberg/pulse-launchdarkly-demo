{
  "name": "pulse-launchdarkly-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Pulse by ABC Company: a LaunchDarkly sample app showing release/remediate, targeting, experimentation, AI Configs and observability.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"node --env-file-if-exists=.env server/dev-server.js\" \"vite\"",
    "build": "vite build",
    "preview": "vite preview",
    "ld:setup": "node --env-file-if-exists=.env scripts/ld-setup.js",
    "ld:traffic": "node --env-file-if-exists=.env scripts/simulate-traffic.js",
    "ld:kill": "node --env-file-if-exists=.env scripts/fire-trigger.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@launchdarkly/node-server-sdk": "^9.16.0",
    "@launchdarkly/observability": "^1.3.1",
    "@launchdarkly/react-sdk": "^4.1.29",
    "@launchdarkly/server-sdk-ai": "^2.0.16",
    "@launchdarkly/session-replay": "^1.2.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "express": "^5.3.0",
    "vite": "^8.3.5"
  }
}
